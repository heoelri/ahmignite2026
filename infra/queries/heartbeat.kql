ContainerLogV2
| where TimeGenerated > ago(15m)
| where _ResourceId =~ '__CLUSTER_ID__' and PodNamespace == 'ignite-demo'
| extend event = parse_json(tostring(LogMessage))
| where tostring(event.kind) == 'health' and tostring(event.role) == '__ROLE__' and tostring(event.flow) == '__FLOW__'
| summarize lastSeen = max(TimeGenerated)
| project value = coalesce(datetime_diff('second', now(), lastSeen), 3600)
